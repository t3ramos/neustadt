{
  "name": "neustadt-3d",
  "version": "3.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4399 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4399 --strictPort",
    "test": "node tools/testing/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests tools package.json vite.config.ts index.html",
    "format:check": "prettier --check src tests tools package.json vite.config.ts index.html",
    "check:architecture": "node tools/check-architecture.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "cannon-es": "0.20.0",
    "lucide": "^0.468.0",
    "three": "^0.183.0",
    "three-gpu-pathtracer": "0.0.24",
    "three-mesh-bvh": "0.9.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.183.0",
    "prettier": "3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "license": "MIT"
}
